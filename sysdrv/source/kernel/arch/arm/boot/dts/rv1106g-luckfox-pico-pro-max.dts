/**********FLASH**********/
&sfc {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********SDMMC**********/
&sdmmc {
	max-freqency = <50000000>;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;

	//sdio
	cap-sdio-irq;
	non-removable;
	no-1-8-v;
	supports-sdio;

	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	status = "okay";
};

/**********ETH**********/
&gmac {
	status = "okay";
};

/**********USB**********/
&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,dis-u2-susphy;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

/**********SPI**********/
&spi0 {
	status = "disabled";
	spidev@0 {
		spi-max-frequency = <50000000>;
	};
	fbtft@0 {
		spi-max-frequency = <50000000>;
	};
};

/**********I2C**********/
/*
 * ducoCarrier_r0 uses THREE I²C buses:
 *
 *   i2c3 M1 -> TCA9546A #1, slots 0..3   ("bus A")   SCL pin 10, SDA pin  9
 *   i2c4 M0 -> TCA9546A #2, slots 4..7   ("bus B")   SCL pin 25, SDA pin 24
 *   i2c1 M1 -> Si5351A clock generator, direct       SCL pin 17, SDA pin 11
 *
 * Only those three controllers reach the 40-pin header, and that is a
 * constraint rather than a preference. Checked group by group against
 * rv1106-pinctrl.dtsi and the header pinout:
 *
 *   i2c0m0 GPIO1_A3/A4   i2c0m1 GPIO4_A1/A0   i2c0m2 GPIO3_A4/A5   none broken out
 *   i2c2m0 GPIO1_A0/A1   i2c2m1 GPIO4_A7/A5                        none broken out
 *   i2c1m1 GPIO2_B0/B1   -> pins 17 / 11    15.24 mm apart, left row
 *   i2c3m0 GPIO2_A6/A7   -> pins 29 / 34    12.70 mm apart, right row
 *   i2c3m1 GPIO1_D3/D2   -> pins 10 /  9     2.54 mm apart, left row
 *   i2c4m0 GPIO2_A1/A0   -> pins 25 / 24     2.54 mm apart, right row
 *   i2c4m1 GPIO1_C2/C3   -> pins 15 / 16     2.54 mm apart, left row
 *
 * So i2c0 and i2c2 are unreachable on this board no matter what is written
 * here, and three is the maximum.
 *
 * **Why the clock gets i2c1 and not a mux.** i2c1m1 is i2c1's only muxing on
 * the header and its two pins are 15.24 mm apart; every other choice has an
 * adjacent pair available. Giving i2c1 to the Si5351A puts the one awkward pair
 * on the shortest run on the board — Y1 sits next to the module — and leaves
 * both mux buses with adjacent pins AND one per side of the module, so the two
 * trunks reach their four slots each without crossing.
 *
 * At 400 kHz with 4.7 kOhm pull-ups none of this is signal integrity: these are
 * open-drain single-ended nets with RC-dominated edges around a microsecond.
 * It is routing tidiness, and the real constraint on that board is distance
 * from the eight 20 MHz clock nets.
 *
 * I2C3_M1 — bus A, the first mux and slots 0..3. GPIO1_D3 = SCL (pin 10),
 * GPIO1_D2 = SDA (pin 9): adjacent pads on the left-hand row, which is the
 * whole reason M1 is used here rather than M0.
 *
 * Two changes from stock, and both are needed:
 *
 *   - status okay. Stock leaves i2c3 disabled, so there is no /dev/i2c-* for
 *     it at all. The node number is NOT probe order: i2c-rk3x.c takes
 *     adap.nr from of_alias_get_id(of_node, "i2c"), so the aliases block
 *     fixes this controller at /dev/i2c-3.
 *
 *   - pinctrl-0 = i2c3m1_xfer. This IS the stock default for i2c3, so the
 *     line changes nothing today — it is written down because the board
 *     depends on it and a silent default is a poor place to keep that. M1 is
 *     <1 RK_PD3 3> + <1 RK_PD2 3> in rv1106-pinctrl.dtsi with
 *     pcfg_pull_none_smt — pull-none plus Schmitt input, which is what you
 *     want when the pull-ups are external. They are: the carrier carries a
 *     4.7 kOhm pair on the 5 V trunk and the PCA9306 has its own on the
 *     3.3 V side.
 *
 * 400 kHz is the ATmega328PB's ceiling, not a tuning choice — the TWI
 * "Features" list caps data transfer at 400 kHz and there is no Fm+ timing
 * row in the datasheet. See hardware/ducoCarrier_r0.md.
 */
&i2c3 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m1_xfer>;
};

/*
 * I2C1_M1 — the third bus, carrying one device: the Si5351A clock generator at
 * 0x60. GPIO2_B0 = SCL (pin 17), GPIO2_B1 = SDA (pin 11).
 *
 * It goes direct, with no level translator, because the Si5351A's I²C pins do
 * not tolerate a 5 V pull-up: V_IHI2C max is 3.6 V and the datasheet supports
 * VDDI2C of 2.25 to 3.63 V only. A dedicated 3.3 V bus is the simplest home for
 * it, and it keeps clock retunes off the two mux buses.
 *
 * Three changes from stock:
 *
 *   - status okay. Stock leaves it disabled, so there is no /dev/i2c-1.
 *     The alias in rv1106.dtsi (`i2c1 = &i2c1`) fixes the node number, which
 *     is NOT probe order — i2c-rk3x.c takes adap.nr from of_alias_get_id().
 *
 *   - 400 kHz instead of 100. The Si5351A takes it, and it keeps all three
 *     buses on one number.
 *
 *   - pinctrl-0 declared explicitly. M1 is already the stock default, so this
 *     changes nothing today — it is written down because M1 is the ONLY muxing
 *     of i2c1 that reaches the header (M0 is GPIO0_A5/A6, bank 0, not broken
 *     out), so there is no fallback if it ever moved.
 *
 * Pull-ups are external, a 4.7 kOhm pair on this segment. Nothing else sits on
 * it, so there is no translator and no second pair.
 */
&i2c1 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m1_xfer>;
};

/*
 * SARADC off. rv1106-luckfox-pico-pro-max-ipc.dtsi turns it on with a
 * vref-supply, and nothing on this board reads it: the two ADC pins
 * (GPIO4_C0/C1) are not in the carrier's pin allocation. The IIO and
 * ROCKCHIP_SARADC drivers are out of the defconfig, so without this the node
 * would sit okay with no driver to bind it — harmless, but it would be the
 * only place where the DTS and the kernel config disagree about what this
 * board has, and that is exactly the kind of disagreement that costs an hour
 * later.
 */
&saradc {
	status = "disabled";
};

/*
 * The on-board work LED, GPIO3_C6. The vendor dtsi asks for the "activity"
 * trigger; this board wants "heartbeat", and the reason is the workload.
 *
 * ledtrig-activity blinks at a rate proportional to system load. A duco head
 * pegs the CPU by design — the miner runs flat out — so activity is
 * effectively solid on, which is indistinguishable from default-state="on" and
 * from a kernel that has stopped. It carries no information here.
 *
 * heartbeat does a double-flash whose period tracks load, so it stays readable
 * at 100%, and — the part that matters — it is generated in kernel context. A
 * duco-master that hangs leaves it blinking; only a dead kernel stops it. That
 * is a liveness signal userspace cannot produce about itself.
 *
 * Status LEDs on the carrier are a different job: they carry application
 * meaning, so the master drives them as plain GPIOs.
 */
&work_led {
	linux,default-trigger = "heartbeat";
};

/*
 * i2c4 M0 — bus B, the second mux and slots 4..7. GPIO2_A1 = SCL (pin 25),
 * GPIO2_A0 = SDA (pin 24): adjacent pads on the right-hand row, so this trunk
 * leaves the module on the opposite side from bus A and neither has to cross
 * the board.
 *
 * **This file used to protect these two pins, and now spends them.** An earlier
 * revision deleted a latent claim on GPIO2_A0/A1 — the -ipc.dtsi declares
 * `pinctrl-names = "default", "conifg"` (the typo is upstream's) with
 * `pinctrl-1 = <&i2c4m0_xfer>`, which nothing ever selects: the pinctrl core
 * applies only "default" at probe, i2c-rk3x.c makes no pinctrl_lookup_state()
 * call, and no driver in this tree looks that name up. The objection was never
 * to using the pins, it was to a *hidden* claim on them. This is an explicit
 * one, which is the distinction that block already drew for uart1m1 on
 * GPIO2_A4/A5. pinctrl-1 is still deleted so the typo'd state cannot come back
 * and double-claim the same group.
 *
 * The carrier's MUXRST_A / MUXRST_B — the GPIOs that force both muxes' channels
 * open when a wedged AVR has jammed a trunk — moved to GPIO1_C0 (pin 12) and
 * GPIO1_C1 (pin 14), both free, to make room here.
 *
 * The two camera sensors the -ipc.dtsi hangs off this bus are switched off.
 * There is no camera on ducoCarrier_r0, and their addresses — 0x30 and 0x31 —
 * sit inside the worker range, so leaving them declared on a bus we now drive
 * is asking for a confusing bus dump. Neither driver is in
 * luckfox_rv1106_linux_defconfig, so nothing would have bound to them in any
 * case; this makes the DTS agree with the kernel config rather than relying on
 * that. Same reasoning as the SARADC block below.
 *
 * They are **disabled, not deleted**: csi_dphy's endpoints hold phandles to
 * &sc3336_out and &mis5001_out, and deleting the nodes breaks those references.
 * The GPIO they claim, &gpio3 RK_PC5, is off-header and conflicts with nothing.
 */
&i2c4 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m0_xfer>;
	/delete-property/ pinctrl-1;
};

&sc3336 {
	status = "disabled";
};

&mis5001 {
	status = "disabled";
};

/**********PWM**********/
/*
 * The eight AVR clocks. Left `disabled` here — enabling them belongs with the
 * clock-generator work — but the muxing is narrowed NOW, because the -ipc.dtsi
 * hands four of these controllers TWO pin sets each and the Luckfox
 * documentation is explicit that only one may be active per controller:
 * "PWM functionality can only be used by one pin at a time".
 *
 * Left as stock, enabling pwm5/6/10 would ALSO mux GPIO2_B0, GPIO2_B1 and
 * GPIO1_D1 — three header pins that ducoCarrier_r0 counts as free, and a PWM
 * carrier appearing on a pin nobody expects.
 *
 *   pwm5  -> m2 = GPIO1_C2   (m1 would be GPIO2_B0)
 *   pwm6  -> m2 = GPIO1_C3   (m1 would be GPIO2_B1)
 *   pwm10 -> m1 = GPIO1_C6   (m2 would be GPIO1_D1)
 *
 * pwm2/3/4/8/9 already declare a single set and need nothing. pwm11 is left
 * alone: the carrier does not use it.
 */
&pwm5 {
	pinctrl-0 = <&pwm5m2_pins>;
};

&pwm6 {
	pinctrl-0 = <&pwm6m2_pins>;
};

&pwm10 {
	pinctrl-0 = <&pwm10m1_pins>;
};

/**********UART**********/
/* UART3_M1 */
&uart3 {
	status = "disabled";
};

/* UART4_M1 */
&uart4 {
	status = "disabled";
};

/**********RTC**********/
&rtc {
	status = "okay";
};
