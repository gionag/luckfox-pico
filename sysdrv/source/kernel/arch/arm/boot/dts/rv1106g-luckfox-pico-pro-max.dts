/dts-v1/;

#include "rv1106.dtsi"
#include "rv1106-evb.dtsi"
#include "rv1106-luckfox-pico-pro-max-ipc.dtsi"

/ {
	model = "Luckfox Pico Pro Max";
	compatible = "rockchip,rv1103g-38x38-ipc-v10", "rockchip,rv1106g3";
};

/**********CRU**********/
/*
 * ARMCLK at 1200 MHz instead of the 1104 MHz rv1106.dtsi assigns.
 *
 * The head is a single Cortex-A7 and the miner needs about 73% of it before a
 * dashboard connects, so the clock is real throughput. rv1106.dtsi pins ARMCLK
 * at 1104 MHz through assigned-clock-rates, and because CONFIG_CPU_FREQ is not
 * in this kernel nothing ever raises it: the cpu0_opp_table's entries up to
 * 1608 MHz have no consumer.
 *
 * vdd_arm on the Pico Pro Max is a regulator-fixed at 900 mV (see
 * rv1106-luckfox-pico-pro-max-ipc.dtsi), and the OPP table asks for:
 *
 *	1104 MHz  850 mV     1416 MHz  925 mV   <- over 900, out
 *	1200 MHz  850 mV     1512 MHz  975 mV   <- out
 *	1296 MHz  875 mV     1608 MHz 1000 mV   <- out
 *
 * 1296 was tried first, on the reasoning that it is the highest entry the fixed
 * supply can hold. It ran, but 1200 is the better place to sit and the reason is
 * the margin: 850 mV against 900 leaves 50 mV, where 1296 leaves 25.
 *
 * That margin matters more than it looks because THE BINNING GATE NEVER RUNS.
 * The OPP voltages are nominal; rockchip's leakage/Pvtm binning adjusts them per
 * part, and that code lives behind CONFIG_CPU_FREQ, which is not in this kernel.
 * So nothing here ever discovers that this particular die wants more than the
 * table's nominal figure — a weak part would simply be undervolted, and an
 * undervolted A7 does not fail loudly, it computes wrong answers. Since the
 * clock buys throughput roughly linearly, giving up 7% of it for double the
 * voltage margin on an unbinned part is the right trade for a machine that is
 * supposed to run unattended.
 *
 * Thermally either is fine: the head measured 57 C at 1104 MHz against a passive
 * trip at 75 C and critical at 115 C.
 *
 * The WHOLE list is repeated deliberately. assigned-clocks is a property, not a
 * merge: naming only ARMCLK here would replace rv1106.dtsi's list outright and
 * silently drop the PLL and bus-root rates with it. Every value below except
 * ARMCLK is copied verbatim from rv1106.dtsi.
 *
 * CLK_500M_SRC is absent on purpose — it is assigned by rv1106g3.dtsi, which
 * this board does not include.
 */
&cru {
	assigned-clocks =
		<&cru PLL_GPLL>, <&cru PLL_CPLL>,
		<&cru ARMCLK>,
		<&cru ACLK_PERI_ROOT>, <&cru HCLK_PERI_ROOT>,
		<&cru PCLK_PERI_ROOT>, <&cru ACLK_BUS_ROOT>,
		<&cru PCLK_TOP_ROOT>, <&cru PCLK_PMU_ROOT>,
		<&cru HCLK_PMU_ROOT>;
	assigned-clock-rates =
		<1188000000>, <1000000000>,
		<1200000000>,
		<400000000>, <200000000>,
		<100000000>, <300000000>,
		<100000000>, <100000000>,
		<200000000>;
};

/**********NPU**********/
//&npu {
//	assigned-clock-rates = <700000000>;
//};

/**********FLASH**********/
&sfc {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********SDMMC**********/
&sdmmc {
	max-freqency = <50000000>;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;

	//sdio
	cap-sdio-irq;
	non-removable;
	no-1-8-v;
	supports-sdio;

	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	status = "okay";
};

/**********ETH**********/
&gmac {
	status = "okay";
};

/**********USB**********/
&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,dis-u2-susphy;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

/**********SPI**********/
&spi0 {
	status = "disabled";
	spidev@0 {
		spi-max-frequency = <50000000>;
	};
	fbtft@0 {
		spi-max-frequency = <50000000>;
	};
};

/**********I2C**********/
/*
 * ducoCarrier_r0 drives TWO I²C buses on the header and holds a third in
 * reserve:
 *
 *   i2c3 M1 -> TCA9546A #1, slots 0..3   ("bus A")   SCL pin 10, SDA pin  9
 *   i2c4 M1 -> TCA9546A #2, slots 4..7   ("bus B")   SCL pin 15, SDA pin 16
 *                + the Si5351A on the 3.3 V side of that trunk
 *   i2c1 M1 -> nothing on the board, kept free       SCL pin 17, SDA pin 11
 *
 * Only those three controllers reach the 40-pin header, and that is a
 * constraint rather than a preference. Checked group by group against
 * rv1106-pinctrl.dtsi and the header pinout:
 *
 *   i2c0m0 GPIO1_A3/A4   i2c0m1 GPIO4_A1/A0   i2c0m2 GPIO3_A4/A5   none broken out
 *   i2c2m0 GPIO1_A0/A1   i2c2m1 GPIO4_A7/A5                        none broken out
 *   i2c1m0 GPIO0_A5/A6                                             not broken out
 *   i2c1m1 GPIO2_B0/B1   -> pins 17 / 11    15.24 mm apart, left row
 *   i2c3m0 GPIO2_A6/A7   -> pins 29 / 34    12.70 mm apart, right row
 *   i2c3m1 GPIO1_D3/D2   -> pins 10 /  9     2.54 mm apart, left row
 *   i2c4m0 GPIO2_A1/A0   -> pins 25 / 24     2.54 mm apart, right row
 *   i2c4m1 GPIO1_C2/C3   -> pins 15 / 16     2.54 mm apart, left row
 *   i2c4m2 GPIO3_C7/D0                                             not broken out
 *
 * So i2c0 and i2c2 are unreachable on this board no matter what is written
 * here, and three is the maximum.
 *
 * **SCL is not always the lower header pin, and i2c4m1 is where that bites.**
 * Every other pair in the table above puts SCL on the HIGHER pin number —
 * i2c3m1 is 10/9, i2c1m1 is 17/11, i2c4m0 was 25/24. i2c4m1 runs the other
 * way: i2c4_scl_m1 is <1 RK_PC2 4> = GPIO1_C2 = pin 15, i2c4_sda_m1 is
 * <1 RK_PC3 4> = GPIO1_C3 = pin 16. The kernel does not care, but a scope
 * clipped by pin order does, and so does anyone reading the header from the
 * outside. Read the group, not the pin numbering.
 *
 * **The clock generator DOES get a controller of its own** — this paragraph said
 * the opposite until 2026-08-28 and it was describing the board as it was before
 * 2026-08-17.
 *
 * The Si5351A used to sit on bus B's 3.3 V segment, upstream of that trunk's
 * PCA9306, sharing i2c4 with the second mux. What it needed was a bus that never
 * sees a 5 V pull-up — V_IHI2C max is 3.6 V and VDDI2C is specified 2.25 to
 * 3.63 V — and the untranslated half of a translated trunk is exactly that.
 *
 * What that arrangement cost was found the hard way: one wedged AVR pulling the
 * 5 V trunk down took the 3.3 V side with it through the PCA9306, so a single
 * stuck chip removed the TIME BASE FOR ALL EIGHT SLOTS. On 2026-08-17 Y1 moved
 * to i2c1, which it now has to itself apart from the panel. Verified on the head
 * 2026-08-28: /proc/iomem lists ff320000.i2c, ff460000.i2c and ff470000.i2c, and
 * the Si5351A answers at 0x60 on /dev/i2c-1.
 *
 * At 400 kHz with 4.7 kOhm pull-ups none of this is signal integrity: these are
 * open-drain single-ended nets with RC-dominated edges around a microsecond.
 * It is routing tidiness, and the real constraint on that board is distance
 * from the eight 20 MHz clock nets.
 *
 * Pull-ups, as fitted: a 4.7 kOhm pair on EACH side of each trunk's PCA9306 —
 * one to 3.3 V, one to 5 V — and a 2.2 kOhm pair to 5 V on every one of the
 * eight slot segments hanging off the muxes.
 *
 * I2C3_M1 — bus A, the first mux and slots 0..3. GPIO1_D3 = SCL (pin 10),
 * GPIO1_D2 = SDA (pin 9): adjacent pads on the left-hand row, which is the
 * whole reason M1 is used here rather than M0.
 *
 * Two changes from stock, and both are needed:
 *
 *   - status okay. Stock leaves i2c3 disabled, so there is no /dev/i2c-* for
 *     it at all. The node number is NOT probe order: i2c-rk3x.c takes
 *     adap.nr from of_alias_get_id(of_node, "i2c"), so the aliases block
 *     fixes this controller at /dev/i2c-3.
 *
 *   - pinctrl-0 = i2c3m1_xfer, and ONLY that group. This is not a restatement
 *     of a default. rv1106.dtsi picks m0; the board's own
 *     rv1106-luckfox-pico-pro-max-ipc.dtsi picks BOTH —
 *     `pinctrl-0 = <&i2c3m1_xfer &i2c3m0_xfer>` — so left alone this
 *     controller would mux GPIO2_A6/A7 (header 29 and 34) as a second SCL/SDA
 *     pair the moment it probes. Naming one group hands those two pads back,
 *     and the carrier counts them free. M1 is <1 RK_PD3 3> + <1 RK_PD2 3> in
 *     rv1106-pinctrl.dtsi with pcfg_pull_none_smt — pull-none plus Schmitt
 *     input, which is what you want when the pull-ups are external. They are.
 *
 * 400 kHz is the ATmega328PB's ceiling, not a tuning choice — the TWI
 * "Features" list caps data transfer at 400 kHz and there is no Fm+ timing
 * row in the datasheet. See hardware/ducoCarrier_r0.md.
 */
&i2c3 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m1_xfer>;
};

/*
 * I2C1_M1 — enabled, and it carries the Si5351A (0x60) and the SH1106 panel
 * (0x3C). GPIO2_B0 = SCL (pin 17), GPIO2_B1 = SDA (pin 11).
 *
 * "Deliberately connected to nothing" is what this said until 2026-08-28, and it
 * was true for ten days: the clock had moved off i2c1 onto bus B's 3.3 V segment
 * and moved BACK on 2026-08-17, when one wedged AVR proved that sharing a
 * translated trunk costs the time base for all eight slots. The mux-B reset
 * trigger that briefly borrowed pin 17 moved to
 * GPIO1_D0 (pin 19). Both pads are therefore free on ducoCarrier_r0 — and they
 * are kept free on purpose, because i2c1m1 is the LAST complete I²C pair the
 * header still has. Bus A has taken GPIO1_D2/D3, bus B GPIO1_C2/C3,
 * i2c3m0's GPIO2_A6/A7 belong to a controller that is already spoken for, and
 * i2c0 and i2c2 do not reach the header at all. Spending 17 and 11 on two more
 * plain GPIOs would cost the board its only spare bus, and plain GPIOs are the
 * one thing this header still has in quantity.
 *
 * So the controller stays enabled with its muxing declared: two pads that
 * nothing else may use, in exchange for a bus that needs no kernel rebuild to
 * exist. A rebuild means a reflash, on hardware that will be in a rack.
 *
 * Three points about the node itself:
 *
 *   - status okay. Stock leaves it disabled, so there would be no /dev/i2c-1.
 *     The alias in rv1106.dtsi (`i2c1 = &i2c1`) fixes the node number, which
 *     is NOT probe order — i2c-rk3x.c takes adap.nr from of_alias_get_id().
 *
 *   - 400 kHz instead of 100, so all three controllers read the same and
 *     whatever eventually lands here inherits the number the AVRs set.
 *
 *   - pinctrl-0 = i2c1m1_xfer. The -ipc.dtsi already picks M1, but rv1106.dtsi
 *     picks M0 — GPIO0_A5/A6, bank 0, not broken out — and M1 is the ONLY
 *     muxing of i2c1 that reaches the header. Declaring it here means a change
 *     in the vendor dtsi cannot silently move this bus onto pins that do not
 *     exist on the module.
 *
 * An enabled controller with no slaves is inert: i2c-rk3x drives the bus only
 * while a transfer is in flight and nothing issues one. Note that the group is
 * pcfg_pull_none and the carrier fits no pull-up pair here, so the two pads
 * float — which is a reason to fit the resistors together with the first
 * device, not a reason to disable the controller.
 */
&i2c1 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m1_xfer>;
};

/*
 * SARADC off. rv1106-luckfox-pico-pro-max-ipc.dtsi turns it on with a
 * vref-supply, and nothing on this board reads it: the two ADC pins
 * (GPIO4_C0/C1) are not in the carrier's pin allocation. The IIO and
 * ROCKCHIP_SARADC drivers are out of the defconfig, so without this the node
 * would sit okay with no driver to bind it — harmless, but it would be the
 * only place where the DTS and the kernel config disagree about what this
 * board has, and that is exactly the kind of disagreement that costs an hour
 * later.
 */
&saradc {
	status = "disabled";
};

/*
 * The on-board work LED, GPIO3_C6. The vendor dtsi asks for the "activity"
 * trigger; this board wants "heartbeat", and the reason is the workload.
 *
 * ledtrig-activity blinks at a rate proportional to system load. A duco head
 * pegs the CPU by design — the miner runs flat out — so activity is
 * effectively solid on, which is indistinguishable from default-state="on" and
 * from a kernel that has stopped. It carries no information here.
 *
 * heartbeat does a double-flash whose period tracks load, so it stays readable
 * at 100%, and — the part that matters — it is generated in kernel context. A
 * duco-master that hangs leaves it blinking; only a dead kernel stops it. That
 * is a liveness signal userspace cannot produce about itself.
 *
 * Status LEDs on the carrier are a different job: they carry application
 * meaning, so the master drives them as plain GPIOs.
 */
&work_led {
	linux,default-trigger = "heartbeat";
};

/*
 * i2c4 M1 — bus B: the second mux with slots 4..7, and the Si5351A.
 * GPIO1_C2 = SCL (pin 15), GPIO1_C3 = SDA (pin 16): adjacent pads on the
 * left-hand row of the header — pins 1..20, which is the row that faces the
 * slots on ducoCarrier_r0, the same row bus A leaves from.
 *
 * **SCL is on the LOWER pin number here, and only here.** i2c4_scl_m1 is
 * <1 RK_PC2 4> and i2c4_sda_m1 is <1 RK_PC3 4> in rv1106-pinctrl.dtsi. Every
 * other pair this board could have used runs SCL-high: i2c3m1 10/9, i2c1m1
 * 17/11, i2c4m0 25/24. Nothing in the kernel notices — the wiring does. This
 * is the one place on the header where "SCL is the odd/lower pin" reasoning
 * gives the wrong answer.
 *
 * Three things hang off this controller: the PCA9306 that translates up to the
 * 5 V trunk, the second TCA9546A behind it, and the Si5351A directly on the
 * 3.3 V side. The clock cannot take a 5 V pull-up (V_IHI2C max 3.6 V, VDDI2C
 * 2.25 to 3.63 V), so it lives on the untranslated half where the pull-ups go
 * to 3.3 V, and it never sees the mux at all.
 *
 * **This node used to select M0, and those two pads are free again.** M0 is
 * GPIO2_A1/A0 = header 25/24, on the edge-facing row. Bus B moved to the
 * slot-facing row so the trunk leaves the module beside the slots it feeds
 * instead of crossing the board, and 24/25 went back to the free list along
 * with the rest of GPIO2_A0..A3 — nothing on ducoCarrier_r0 uses any of them
 * now.
 *
 * pinctrl-1 stays deleted, and it is worth restating why now that the pins it
 * named are free rather than in use. The -ipc.dtsi declares
 * `pinctrl-names = "default", "conifg"` (the typo is upstream's) with
 * `pinctrl-1 = <&i2c4m0_xfer>`, a state nothing ever selects: the pinctrl core
 * applies only "default" at probe, i2c-rk3x.c makes no pinctrl_lookup_state()
 * call, and no driver in this tree looks that name up. Inert — but it is a
 * *hidden* claim on GPIO2_A0/A1, and deleting the property is what makes those
 * pads free by construction instead of by argument about driver internals.
 *
 * The pinctrl-0 line is a real override in both directions: the -ipc.dtsi's
 * "default" is i2c4m2_xfer (GPIO3_C7/D0, bank 3, not broken out), so this drops
 * a muxing that goes nowhere and names the one that goes to the header.
 *
 * The two camera sensors the -ipc.dtsi hangs off this bus are switched off.
 * There is no camera on ducoCarrier_r0, and their addresses — 0x30 and 0x31 —
 * sit inside the worker range, so leaving them declared on a bus we now drive
 * is asking for a confusing bus dump. Neither driver is in
 * luckfox_rv1106_linux_defconfig, so nothing would have bound to them in any
 * case; this makes the DTS agree with the kernel config rather than relying on
 * that. Same reasoning as the SARADC block above.
 *
 * They are **disabled, not deleted**: csi_dphy's endpoints hold phandles to
 * &sc3336_out and &mis5001_out, and deleting the nodes breaks those references.
 * The GPIO they claim, &gpio3 RK_PC5, is off-header and conflicts with nothing.
 */
&i2c4 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m1_xfer>;
	/delete-property/ pinctrl-1;
};

&sc3336 {
	status = "disabled";
};

&mis5001 {
	status = "disabled";
};

/**********PWM**********/
/*
 * No PWM controller is enabled on this board, and two of them no longer have a
 * pad left to be narrowed onto.
 *
 * The narrowing exists because the -ipc.dtsi hands four PWM controllers TWO
 * pin sets each while the Luckfox documentation is explicit that only one may
 * be live: "PWM functionality can only be used by one pin at a time". Naming
 * one set stops the second pad being muxed away the moment the controller
 * probes.
 *
 * **pwm5 and pwm6 no longer have a set to name.** Both of their pads are now
 * I²C on ducoCarrier_r0:
 *
 *   pwm5  m1 = GPIO2_B0 (i2c1 SCL, pin 17)   m2 = GPIO1_C2 (i2c4 SCL, pin 15)
 *   pwm6  m1 = GPIO2_B1 (i2c1 SDA, pin 11)   m2 = GPIO1_C3 (i2c4 SDA, pin 16)
 *
 * There is no third muxing for either, so narrowing them to either set would
 * be aiming a clock output at an I²C line — a narrowing that reads like a
 * safety measure and is the opposite. The overrides are deleted rather than
 * rewritten: both nodes are `status = "disabled"` in rv1106.dtsi and nothing
 * here enables them, CONFIG_PWM_ROCKCHIP is not in
 * luckfox_rv1106_linux_defconfig, and pinctrl is applied at driver bind — so
 * the stock two-set claim they fall back to is inert twice over.
 * **Enabling pwm5 or pwm6 on this carrier is the landmine.** If an extra clock
 * output is ever wanted, take it from the Si5351A: CLK2 is unused.
 *
 * pwm10 keeps its narrowing, because for pwm10 the choice is still a choice:
 * m1 = GPIO1_C6 (header 5) and m2 = GPIO1_D1 (header 20) are both free pads,
 * and one set is what the hardware allows.
 *
 * pwm0/2/3/4/8/9 declare a single set each and need nothing here, and pwm11
 * keeps its stock pair — but four of those sets do land on pads this board
 * uses, pwm11m2 (GPIO1_D3) on bus A's SCL among them. They stay because a
 * disabled node claims nothing; they are catalogued in the pin-claim audit
 * below so that "just enable a PWM" is never a one-line change.
 */
&pwm10 {
	/*
	 * ENABLED, for the fan. rv1106.dtsi leaves this node disabled and every
	 * other PWM in the include chain stays that way — see the pin-claim audit
	 * in hardware/ducoCarrier_r0.md for why "just enable a PWM" is never a
	 * one-line change on this board.
	 *
	 * m1 is GPIO1_C6, header pin 5, and the carrier's netlist confirms where it
	 * goes: J1.5 -> /FAN_PWM -> Q5 gate (BSS138, source GND, drain to M1 pin 4,
	 * the fan header's PWM input). R85 pulls the gate down.
	 *
	 * SO IT INVERTS, AND THAT IS THE SAFE DIRECTION. R87 (10 kΩ) pulls that
	 * drain up to +5 V and a 4-pin fan reads duty as time-HIGH, so:
	 *
	 *	pin HIGH -> FET conducts -> fan input at GND -> 0 % -> fan stops
	 *	pin LOW  -> FET off      -> R87 pulls to 5 V  -> 100 % -> full speed
	 *
	 * At boot the SoC pad is an input and R85 holds the gate off, so the fan
	 * runs FLAT OUT until software says otherwise — which is what a thermal
	 * device should do when nothing is in control. duco-fan therefore writes
	 * duty_cycle = period * (1 - wanted), and a duty of 0 means full speed.
	 *
	 * TACH is the other half: M1 pin 3 -> /FAN_SPEED -> J1.6 (GPIO1_C5), pulled
	 * to 3V3 by R86. It is a plain GPIO, counted in software, not a PWM capture.
	 *
	 * M1 is do-not-place on r0, so on this board the pad is driven and nothing
	 * listens. That is harmless and it lets the driver be tested on the bench.
	 */
	pinctrl-0 = <&pwm10m1_pins>;
	status = "okay";
};

/**********PIN CLAIMS — WHAT ELSE NAMES THE CARRIER'S PADS**********/
/*
 * Every pad ducoCarrier_r0 uses is also named by at least one other node in
 * this include chain. None of those claims is live: every claimant in the two
 * tables below is `status = "disabled"`, and pinctrl is applied at driver bind,
 * so a disabled node muxes nothing. Most have no driver in
 * luckfox_rv1106_linux_defconfig either — there is no CONFIG_PWM_ROCKCHIP, no
 * CONFIG_SPI, no CONFIG_FB_TFT. The one claim that is not status-gated is at
 * the end of this block.
 *
 * The list matters anyway, because it is what turns "just enable that
 * controller" into a decision. Read off the built DTB, not the sources:
 *
 *   pin 10  GPIO1_D3  bus A SCL      also pwm11m2_pins
 *   pin  9  GPIO1_D2  bus A SDA      also pwm0m1_pins
 *   pin 15  GPIO1_C2  bus B SCL      also pwm5m2_pins, spi0m0_mosi
 *   pin 16  GPIO1_C3  bus B SDA      also pwm6m2_pins, spi0m0_miso,
 *                                    and fbtft@0's reset-gpios
 *   pin 17  GPIO2_B0  i2c1 SCL, held free
 *                                    also pwm5m1_pins, uart0m1_xfer,
 *                                    and fbtft@0's led-gpios
 *   pin 11  GPIO2_B1  i2c1 SDA, held free
 *                                    also pwm6m1_pins, uart0m1_xfer,
 *                                    and fbtft@0's dc-gpios
 *
 * And the three pins the master drives as plain GPIO from userspace:
 *
 *   pin  7  GPIO1_C4  INT_N, the wired-OR alert from the eight expanders
 *                                    also uart4m1_xfer, pwm8m1_pins
 *   pin 12  GPIO1_C0  MUX_0_RST_TRG  also spi0m0_cs0, pwm2m2_pins
 *   pin 19  GPIO1_D0  MUX_1_RST_TRG  also uart3m1_xfer, pwm3m2_pins
 *
 * Both RST_TRG lines drive the GATE of an N-FET that pulls the mux's
 * active-low RESET down, so **the GPIO is asserted HIGH to reset the mux** —
 * the FET inverts, and the mux's own pin never sees the 3.3 V rail. That
 * inversion belongs in the master, not here; it is written down because a DTS
 * reader looking for an active-low line will not find one.
 *
 * spi0 deserves its own line: spi0m0 claims GPIO1_C0/C1/C2/C3 = header 12, 14,
 * 15 and 16 — the mux A reset trigger, one genuinely free pin, and BOTH of bus
 * B's pads. It is the single node in this tree that would do the most damage if
 * it were ever enabled, which is why it is explicitly disabled above rather
 * than left to the vendor default.
 *
 * One claim is NOT gated by a status property: the -ipc.dtsi declares a
 * root-level `dht11_sensor` node with `pinctrl-0 = <&gpio1_pc7>` and
 * `gpios = <&gpio1 RK_PC7 ...>` — header pin 4, which this board counts free.
 * The node has no `status`, so it defaults to okay, and it survives into the
 * built DTB. What actually stops it is that CONFIG_DHT11 is absent, so nothing
 * binds and no pinctrl state is ever applied. Left alone because nothing on the
 * carrier wants pin 4, but it is the one latent claim here that a kernel-config
 * change could wake without anybody touching a device tree.
 */

/**********UART**********/
/* UART3_M1 — GPIO1_D0/D1, header 19 and 20. Pin 19 is MUX_1_RST_TRG. */
&uart3 {
	status = "disabled";
};

/* UART4_M1 — GPIO1_C4/C5, header 7 and 6. Pin 7 is INT_N. */
&uart4 {
	status = "disabled";
};

/**********RTC**********/
&rtc {
	status = "okay";
};
