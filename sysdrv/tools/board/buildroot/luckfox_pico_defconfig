# Buildroot defconfig, tuned for the duco-master miner head.
#
# Stripped vs upstream luckfox_pico_defconfig:
#   - Python3 + 12 modules (~33.7 MB on disk, nothing on the rig runs it)
#   - multimedia libs (libv4l, libdrm, freetype) — kernel strips those
#     subsystems too so the userspace half is dead weight
#   - iptables + nftables — kernel netfilter is stripped, these binaries
#     would just error at runtime
#   - archiver bloat (p7zip, unzip, zip, standalone xz)
#   - network diagnostics not needed in prod (bmon, iperf, iperf3, wget
#     standalone, lrzsz, GNU time, nano)
#   - rsync (deploy flow uses scp)
#   - libcurl + curl (Go stdlib HTTP, busybox wget handles shell fetches)
#   - pcre2 16/32 (no PCRE consumers on the rig)
#   - librsync (dropped with rsync)
#   - bash_loadable_examples (demo cruft)
#   - evtest (no input devices)
#
# Added:
#   - i2c-tools (i2cdetect/i2cget/i2cset — used for AVR jig debugging)
#
# Kept: everything the duco stack, luckfox-config, sshd, DHCP, or
# first-boot rootfs-expand relies on.

# ---- toolchain + arch ----
BR2_arm=y
BR2_cortex_a7=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PATH="../../../../tools/linux/toolchain/arm-rockchip830-linux-uclibcgnueabihf"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-rockchip830-linux-uclibcgnueabihf"
BR2_TOOLCHAIN_EXTERNAL_GCC_8=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_WCHAR=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# ---- global build flags ----
BR2_PRIMARY_SITE="http://sources.buildroot.net"
BR2_OPTIMIZE_3=y

# ---- system identity ----
BR2_TARGET_GENERIC_HOSTNAME="luckfox"
BR2_TARGET_GENERIC_ISSUE="Welcome to luckfox duco-master"
BR2_TARGET_GENERIC_ROOT_PASSWD="luckfox"
BR2_SYSTEM_ENABLE_NLS=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# ---- compression (log rotation, update.img unpack) ----
BR2_PACKAGE_GZIP=y

# ---- filesystem tools (first-boot rootfs expand) ----
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y

# ---- TLS / PKI (sshd, future HTTPS fetches) ----
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_GNUTLS=y
BR2_PACKAGE_LIBMD=y

# ---- device-tree runtime (luckfox-config overlays) ----
BR2_PACKAGE_DTC=y
BR2_PACKAGE_DTC_PROGRAMS=y
BR2_PACKAGE_HOST_DTC=y

# ---- I2C userspace tools (AVR jig debugging) ----
BR2_PACKAGE_I2C_TOOLS=y

# ---- networking ----
# NTP comes from busybox's ntpd applet (enabled in busybox.config),
# not the GNU ntp package — GNU ntpd 4.2.8p15 is fragile on minimal
# rigs (strict CVE-2020-13817 aorg check silently drops the first
# reply and never resyncs).
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_SOCAT=y

# ---- shell & TUI (luckfox-config + operator quality of life) ----
BR2_PACKAGE_BASH=y
BR2_PACKAGE_DIALOG=y
BR2_PACKAGE_HTOP=y

# ---- util-linux mount helpers ----
BR2_PACKAGE_UTIL_LINUX_LIBMOUNT=y
